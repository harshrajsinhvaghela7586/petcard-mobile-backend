# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_SECRET=            # 32+ random characters
ADMIN_ORIGIN=          # admin panel origin(s) for CORS, comma separated
PUBLIC_BASE_URL=       # public URL of this API, used in pet QR links
APP_SCHEME=
# Mail
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_FROM=
SUPPORT_EMAIL=
MAIL_DRY_RUN=true
# Cloudinary
CLOUD_NAME=
CLOUD_KEY=
CLOUD_SECRET=
CLOUDINARY_UPLOAD_PRESET=
# Push + AI assistant + jobs
PUSH_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
JOBS_ENABLED=true

# Comma-separated Google OAuth client IDs (Web + Android client IDs)
GOOGLE_OAUTH_CLIENT_IDS=

GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
